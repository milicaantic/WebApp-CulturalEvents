@model ProjekatWebKulturniDogadjaji.Models.Category

<h2 class="text-center mb-4" style="color:#1B4D3E;">Create Category</h2>

<form asp-action="Create" method="post" class="mx-auto" style="max-width: 500px;">
    <div class="form-group mb-3">
        <label asp-for="Name" class="form-label">Name</label>
        <input asp-for="Name" class="form-control shadow-sm" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="text-center">
        <button type="submit" class="btn text-white btn-lg" style="background-color:#690B22; border-color:#690B22;">Create</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
