@page
@model LoginModel
@{
    ViewData["Title"] = "Prijavljivanje";
}

<div class="d-flex flex-column align-items-center justify-content-center vh-100  pt-5" style=" background-color: rgba(248, 249, 250, 0.7);">
    <div class=" bg-white border rounded-4 shadow p-5 col-md-8 col-lg-6">
            <h3 class="text-center mb-4">@ViewData["Title"]</h3>

            <form method="post">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" placeholder="Email" />
                    <label asp-for="Input.Email">Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" type="password" class="form-control" placeholder="Lozinka" />
                    <label asp-for="Input.Password">Lozinka</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="Input.RememberMe" class="form-check-input" />
                    <label asp-for="Input.RememberMe" class="form-check-label">Zapamti me</label>
                </div>

                <div class="text-center">
                <button type="submit" class="btn btn-pink btn-lg w-100" style="background-color: #690B22;; border:none; color:white;">
                        Prijavi se
                    </button>
                </div>

                <div class="mt-3 text-center">
                    <a asp-page="/Account/Register">Nemate nalog? Registrujte se.</a>
                </div>
               
            </form>
        </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
