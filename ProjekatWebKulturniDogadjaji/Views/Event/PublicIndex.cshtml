@model IEnumerable<ProjekatWebKulturniDogadjaji.Models.Event>

@using Azure.Core
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ProjekatWebKulturniDogadjaji.Models.ApplicationUser> SignInManager
@inject UserManager<ProjekatWebKulturniDogadjaji.Models.ApplicationUser> UserManager

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-4" style="color:#1B4D3E;">Cultural Events</h2>

        @if (SignInManager.IsSignedIn(User))
        {
            <a asp-controller="Event" asp-action="Create"
               class="btn btn-lg text-white"
               style="background-color:#690B22; border-color:#690B22;">
                + Create New Event
            </a>
        }
    </div>

    @{
        var categories = ViewBag.Categories as List<Category>;
        string selectedCategory = Context.Request.Query["categoryId"];
        string dateFromValue = Context.Request.Query["dateFrom"];
        string dateToValue = Context.Request.Query["dateTo"];
    }   
    <form asp-action="PublicIndex" method="get" class="row g-2 mb-4">
        <div class="col-md-3">
            <label for="categoryId" class="form-label">Category</label>
            <select name="categoryId" class="form-select">
                <option value="">All categories</option>
                @foreach (var category in categories)
                {
                    if (ViewBag.SelectedCategoryId == category.Id.ToString())
                    {
                        <option value="@category.Id" selected>@category.Name</option>
                    }
                    else
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                }

            </select>
        </div>

        <div class="col-md-3">
            <label for="dateFrom" class="form-label">From date</label>
            <input type="date" name="dateFrom" class="form-control" value="@dateFromValue" />
        </div>

        <div class="col-md-3">
            <label for="dateTo" class="form-label">To date</label>
            <input type="date" name="dateTo" class="form-control" value="@dateToValue" />
        </div>

        <div class="col-md-3 d-flex align-items-end">
            <button type="submit" class="btn w-100" style="background-color: #F1E3D3; color: #690B22;">Filter</button>
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="fw-semibold">Title</th>
                            <th class="fw-semibold">Category</th>
                            <th class="fw-semibold">Start Date</th>
                            <th class="fw-semibold">Location</th>
                            <th class="fw-semibold">Description</th>
                            <th class="fw-semibold">Status</th>
                            @if (SignInManager.IsSignedIn(User))
                            {
                                <th class="fw-semibold" style="width:220px;">Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var evt in Model)
                        {
                            var categoryName = evt.Category?.Name ?? "-";
                            var startDisplay = evt.StartDate.ToString("dd.MM.yyyy HH:mm");
                            var currentUserId = UserManager.GetUserId(User);
                            var isOwner = string.Equals(evt.CreatorId, currentUserId, StringComparison.OrdinalIgnoreCase);
                            var isAdmin = User.IsInRole("Admin");

                            <tr>
                                <td style="min-width:180px;">@evt.Title</td>
                                <td style="min-width:140px;">@categoryName</td>
                                <td style="min-width:140px;">@startDisplay</td>
                                <td style="min-width:140px;">@evt.Location</td>
                                <td style="max-width:320px;">
                                    <div class="text-truncate" style="max-width:320px;">@evt.Description</div>
                                </td>
                                <td style="min-width:120px;">
                                    @if (evt.IsApproved)
                                    {
                                        <span class="badge" style="background-color:#1B4D3E; color:#F1E3D3;">Approved</span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background-color:#F1E3D3; color:#690B22;">Pending Approval</span>
                                    }
                                </td>
                                @if (SignInManager.IsSignedIn(User))
                                {
                                    <td>
                                        <div class="d-flex gap-2">
                                            <a asp-action="Details" asp-route-id="@evt.Id" class="btn btn-sm"
                                               style="border:1px solid #1B4D3E; color:#1B4D3E;">Details</a>

                                            @if (isOwner || isAdmin)
                                            {
                                                <a asp-action="Edit" asp-route-id="@evt.Id" class="btn btn-sm"
                                                   style="background-color: #F1E3D3; color: #690B22; border-color:#F1E3D3;">
                                                    Edit
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@evt.Id" class="btn btn-sm"
                                                   style="border:1px solid #690B22; color:#690B22;">
                                                    Delete
                                                </a>
                                            }
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (!(SignInManager.IsSignedIn(User)))
    {
        <div class="mt-3 text-center">
            <p class="text-muted mb-0">
                Log in to view more details and access more options.
            </p>
        </div>
    }
</div>
