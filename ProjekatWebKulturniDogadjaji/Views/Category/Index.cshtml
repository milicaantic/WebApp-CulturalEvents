@model IEnumerable<ProjekatWebKulturniDogadjaji.Models.Category>
@using Microsoft.AspNetCore.Identity
@inject UserManager<ProjekatWebKulturniDogadjaji.Models.ApplicationUser> UserManager
@inject SignInManager<ProjekatWebKulturniDogadjaji.Models.ApplicationUser> SignInManager
<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

    @if (User.IsInRole("Admin"))
    {
        <h2 class="text-center mb-4" style="color:#1B4D3E;">Kategorije</h2>
        <a asp-action="Create" class="btn text-white btn-lg" style="background-color:#690B22; border-color:#690B22;"> + Napravi novu kategoriju</a>
    }
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Ime</th>
                        <th>Status</th>
                        <th>Akcije</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td>@category.Name</td>
                            <td>
                                @if (category.IsApproved)
                                {
                                    <span class="badge" style="background-color:#1B4D3E; color:#F1E3D3;">Odobren</span>
                                }
                                else
                                {
                                    <span class="badge" style="background-color:#690B22; color:#F1E3D3;">Čeka odobrenje</span>
                                }
                            </td>
                            <td>
                                  
                                    <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm" style="background-color: #F1E3D3; color: #690B22; border-color:#F1E3D3;">Izmeni</a>
                                    <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-sm" style="border:1px solid #690B22; color:#690B22;">Obriši</a>

                                    @if (User.IsInRole("Admin") && !category.IsApproved)
                                    {
                                        <form asp-action="Approve" asp-route-id="@category.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm" style="background-color: #1B4D3E; color:white;">Odobri</button>
                                        </form>
                                    }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </<div>
  </div>
</div>
        </div>