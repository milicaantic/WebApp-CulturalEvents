@using Microsoft.AspNetCore.Identity
@inject SignInManager<ProjekatWebKulturniDogadjaji.Models.ApplicationUser> SignInManager
@inject UserManager<ProjekatWebKulturniDogadjaji.Models.ApplicationUser> UserManager
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString();
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();

    bool isNonTransparent =
        (currentController == "Home" && currentAction == "Index") ||
      (currentArea == "Identity" && currentPage != null &&
            (currentPage.EndsWith("/Login") || currentPage.EndsWith("/Register")));
    var backgroundOpacity = isNonTransparent ? "1" : "0.65";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] Cultural Events</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100" >
    <header class="sticky-top">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Cultural Events</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav ms-auto d-flex align-items-center">
              
                        <li class="nav-item">
                            <a class="nav-link text-dark p-2 rounded border-start-0" asp-area="" asp-controller="Home" asp-action="Index"
                               onmouseover="this.style.backgroundColor='#F1E3D3';" onmouseout="this.style.backgroundColor='transparent';">
                                Home
                            </a>
                        </li>
                        @if (SignInManager.IsSignedIn(User))
                        {

                            <li class="nav-item border-start">
                                <a class="nav-link text-dark p-2 rounded" asp-controller="Event" asp-action="MyEvents"
                                   onmouseover="this.style.backgroundColor='#F1E3D3';" onmouseout="this.style.backgroundColor='transparent';">
                                    My Events
                                </a>
                            </li>


                            var currentUser = await UserManager.GetUserAsync(User);
                            var isAdmin = currentUser != null && await UserManager.IsInRoleAsync(currentUser, "Admin");

                            @if (isAdmin)
                            {
                                <li class="nav-item border-start">
                                    <a class="nav-link text-dark p-2 rounded" asp-controller="Category" asp-action="Index"
                                       onmouseover="this.style.backgroundColor='#F1E3D3';" onmouseout="this.style.backgroundColor='transparent';">
                                         Categories
                                    </a>
                                </li>
                                <li class="nav-item border-start">
                                    <a class="nav-link text-dark p-2 rounded" asp-controller="Event" asp-action="Pending"
                                       onmouseover="this.style.backgroundColor='#F1E3D3';" onmouseout="this.style.backgroundColor='transparent';">
                                        Event Approval
                                    </a>
                                </li>
                            }

                            var user = await UserManager.GetUserAsync(User);
                            var displayName = user?.FullName ?? user?.UserName ?? User.Identity?.Name;


                            <li class="nav-item border-start">
                                <form class="form-inline d-inline" asp-area="Identity" asp-page="/Account/Logout" method="post"
                                      asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                    <button type="submit" class="nav-link btn btn-link text-dark p-2 rounded"
                                            style="text-decoration:none;"
                                            onmouseover="this.style.backgroundColor='#F1E3D3';" onmouseout="this.style.backgroundColor='transparent';">
                                        @displayName - Log out
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item border-start">
                                <a class="nav-link text-dark p-2 rounded" asp-area="Identity" asp-page="/Account/Register"
                                   onmouseover="this.style.backgroundColor='#F1E3D3';" onmouseout="this.style.backgroundColor='transparent';">
                                    Register
                                </a>
                            </li>
                            <li class="nav-item border-start">
                                <a class="nav-link text-dark p-2 rounded" asp-area="Identity" asp-page="/Account/Login"
                                   onmouseover="this.style.backgroundColor='#F1E3D3';" onmouseout="this.style.backgroundColor='transparent';">
                                    Log in
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="flex-grow-1 position-relative">

 
        <div class="container">
            <main role="main" class="pb-3">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>

        <div style="
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 50%;
            background-image:  url('/images/2002.i305.019.F.m005.c5.fashion history ancient times present.jpg');
            background-repeat: no-repeat;
            background-position: center bottom;
            background-size: cover;
            opacity: @backgroundOpacity;
            z-index: -1;
        "></div>

    </div>
   

    <footer class="border-top footer text-muted mt-auto bg-light">
        <div class="container">
            &copy; 2025 - Cultural Events
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
